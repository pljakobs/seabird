[Unit]
Description=NVMe seabird backup storage
DefaultDependencies=no
After=blockdev@dev-disk-by\x2dlabel-seabird\x2ddata.target

[Mount]
What=LABEL=seabird-data
Where=/srv/seabird/backup
Type=btrfs
Options=noatime,compress=zstd:1,space_cache=v2,subvol=@backup

[Install]
WantedBy=seabird-mounts.target
