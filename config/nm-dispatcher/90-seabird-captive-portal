#!/usr/bin/env bash
# /etc/NetworkManager/dispatcher.d/90-seabird-captive-portal
#
# Detects when a WAN WiFi interface enters captive portal state and exposes
# the portal via a Caddy reverse proxy on the LAN so any crew browser can
# authenticate without knowing the portal's real URL.
#
# Flow:
#   1. NM detects portal (CONNECTIVITY_STATE=PORTAL) on wlan0
#   2. This script generates a Caddy snippet reverse-proxying the portal URL
#      under http://seabird.local/portal/
#   3. Crew opens http://seabird.local/portal/ — Caddy forwards to portal
#      using wlan0's IP (which is what the portal authenticates)
#   4. Portal clears → CONNECTIVITY_STATE=FULL → snippet removed, Caddy reloaded
#
# Requires:
#   - caddy installed and running as caddy.service
#   - /etc/caddy/conf.d/ include-dir configured in main Caddyfile
#   - seabird.local DNS resolving to LAN IP (via dnsmasq/systemd-resolved)

set -euo pipefail

IFACE="$1"
ACTION="$2"
STATUS_FILE="/run/seabird/captive-portal.json"
CADDY_SNIPPET="/etc/caddy/conf.d/portal.caddy"
SEABIRD_DOMAIN="${SEABIRD_DOMAIN:-seabird.local}"

# Only act on WAN WiFi interfaces
if [[ "${IFACE}" != "wlan0" ]]; then
    exit 0
fi

mkdir -p /run/seabird /etc/caddy/conf.d

_caddy_reload() {
    if systemctl is-active --quiet caddy; then
        systemctl reload caddy 2>/dev/null || systemctl restart caddy
    fi
}

case "${ACTION}" in

connectivity-change)
    case "${CONNECTIVITY_STATE:-}" in

    PORTAL)
        PORTAL_URL="${CONNECTIVITY_CHECK_URL:-unknown}"

        logger -t seabird-captive-portal \
            "Captive portal detected on ${IFACE}: ${PORTAL_URL}"

        # Generate Caddy reverse proxy snippet
        # /portal/* on seabird.local is transparently forwarded to the portal.
        # Caddy runs on the router so all requests originate from wlan0's IP.
        cat > "${CADDY_SNIPPET}" <<EOF
# Auto-generated by seabird-captive-portal dispatcher — do not edit
# Portal URL: ${PORTAL_URL}
http://${SEABIRD_DOMAIN} {
    handle /portal/* {
        uri strip_prefix /portal
        reverse_proxy ${PORTAL_URL} {
            header_up Host {upstream_hostport}
            header_up X-Forwarded-For ""
        }
    }
}
EOF

        _caddy_reload

        LOCAL_URL="http://${SEABIRD_DOMAIN}/portal/"

        # Write machine-readable status
        printf '{"interface":"%s","state":"portal","portal_url":"%s","local_url":"%s","since":"%s"}\n' \
            "${IFACE}" "${PORTAL_URL}" "${LOCAL_URL}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            > "${STATUS_FILE}"

        wall <<EOF

*** SEABIRD — Marina WiFi requires login ***
Open this URL in any browser to authenticate:

  ${LOCAL_URL}

Other uplinks (wwan0, end0) are unaffected.

EOF
        ;;

    FULL)
        if [[ -f "${STATUS_FILE}" ]]; then
            logger -t seabird-captive-portal \
                "Captive portal cleared on ${IFACE} — full connectivity restored"

            rm -f "${CADDY_SNIPPET}" "${STATUS_FILE}"
            _caddy_reload

            wall <<EOF

*** SEABIRD — Marina WiFi authenticated, full connectivity restored ***

EOF
        fi
        ;;
    esac
    ;;

down)
    if [[ -f "${STATUS_FILE}" ]]; then
        rm -f "${CADDY_SNIPPET}" "${STATUS_FILE}"
        _caddy_reload
    fi
    ;;
esac

exit 0
