# seabird Caddyfile
# Serves the boat router management interface on the LAN.
# Dynamic snippets (e.g. captive portal proxy) are dropped into conf.d/
# and picked up via the import directive below.

{
    admin localhost:2019
}

# Dedicated listener for clients requesting host:8083 (used by AvNav ocharts UI)
:8083 {
  # Browser clients may preflight cross-origin requests to :8083.
  # Respond explicitly to OPTIONS so fetch() does not fail with NetworkError.
  # Also handle Chrome Private Network Access (PNA) preflights.
  @preflight {
    method OPTIONS
    header Origin *
  }
  header @preflight Access-Control-Allow-Origin "{http.request.header.Origin}"
  header @preflight Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  header @preflight Access-Control-Allow-Headers "{http.request.header.Access-Control-Request-Headers}"
  header @preflight Access-Control-Allow-Private-Network "true"
  header @preflight Access-Control-Max-Age "86400"
  respond @preflight "" 204

  # Reflect Origin for browser CORS checks on actual requests.
  @cors header Origin *
  header @cors Access-Control-Allow-Origin "{http.request.header.Origin}"
  header @cors Access-Control-Allow-Credentials "true"
  header @cors Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  header @cors Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, Cache-Control, Pragma"
  header @cors Access-Control-Max-Age "86400"
  header @cors Vary "Origin"

  # Rewrite the internal Podman container IP that oexserverd bakes into avnav.xml
  # and encrypted tile URLs (e.g. http://10.88.0.x:8083/...).  The container IP
  # changes on every restart; replace it with whatever host:port the client used.
  replace re "http://10\.88\.[0-9]+\.[0-9]+:8083" "http://{http.request.hostport}"

  reverse_proxy 127.0.0.1:28083 {
    # Backend returns wildcard ACAO; replace with reflected Origin to stay valid
    # when credentials/cookies are used by browser-side fetch.
    header_down -Access-Control-Allow-Origin
    header_down -Access-Control-Allow-Credentials
    header_down -Vary
    # Prevent backend compression so replace can rewrite response bodies
    header_up Accept-Encoding identity
  }
}

# Landing page — links to management services and path-based service entrypoints
:80 {
  # Serve homepage background images from host storage.
  handle_path /homepage-bg/* {
    root * /srv/seabird/homepage/images
    file_server
  }

    handle /api/portal-status {
        # Serve captive-portal.json if present; 404 otherwise.
        # /run/seabird is bind-mounted into the container.
        root * /run/seabird
        try_files /captive-portal.json
        file_server
    }

    handle /portal/* {
        # Placeholder — overridden by conf.d/portal.caddy when a captive
        # portal is active. Returns 503 otherwise so crew gets a clear message.
        respond "No captive portal active." 503
    }

  # AvNav UI (served under /avnav) issues absolute /api and /api/... requests.
  # Bridge those back to AvNav only when they originate from /avnav pages,
  # so other /api endpoints (Homepage, portal-status, etc.) are unaffected.
  @avnav_api {
    path /api /api/*
    not path /api/portal-status
    header Referer *avnav*
  }
  handle @avnav_api {
    reverse_proxy 127.0.0.1:8088
  }

  # Grafana — sub-path aware (GF_SERVER_SERVE_FROM_SUB_PATH=true)
  # Keep the /grafana prefix when proxying (no handle_path), otherwise
  # Grafana sees / and redirects back to /grafana/ in a loop.
  # Rewrite absolute redirects to relative so host stays tailscale/LAN-safe.
  handle /grafana* {
    reverse_proxy 127.0.0.1:3001 {
      header_down Location "^(?:https?://[^/]+)?(/grafana(?:/.*)?)$" "$1"
    }
  }

  # Navidrome — sub-path aware (ND_BASEURL=/navidrome)
  # Keep the /navidrome prefix when proxying to avoid redirect loops.
  handle /navidrome* {
    reverse_proxy 127.0.0.1:4533
  }

  # Pi-hole — strip prefix before forwarding
  handle_path /pihole* {
    reverse_proxy 127.0.0.1:3003
  }

  # o-charts backend via local-origin proxy path
  handle_path /ocharts* {
    reverse_proxy 127.0.0.1:28083 {
      # Tell ocharts the public origin it should advertise back to clients.
      # The backend can use this to emit relative or hostless URLs instead of
      # baking in the container-internal address.
      header_up Host {hostport}
      header_up X-Forwarded-Host {hostport}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # Signal-K admin — redirect to SignalK's native port 3000.
  # The admin SPA makes root-level API calls (/plugins, /webapps, /appstore/*)
  # that conflict with AvNav's root-relative paths when served via port 80.
  # Routing by Referer header is unreliable because SignalK's Helmet middleware
  # sets 'Referrer-Policy: no-referrer' and the SPA's fetch() calls may also
  # set referrerPolicy:'no-referrer' explicitly.
  # Port 3000 is published on all interfaces (PublishPort=3000:3000) so the
  # browser can reach it directly — no routing conflict possible.
  @signalk_root path /signalk /signalk/ /signalk/admin /signalk/admin/
  redir @signalk_root http://{http.request.host}:3000/admin/ 302

  @signalk_admin_redir path_regexp sk_admin ^/signalk(/admin/.+)$
  redir @signalk_admin_redir http://{http.request.host}:3000{http.regexp.sk_admin.1} 302

  # Keep /signalk prefix when proxying. Signal-K API/UI paths are rooted at
  # /signalk/v1/... and /signalk/admin/.
  handle /signalk* {
    reverse_proxy 127.0.0.1:3000
  }

  # SignalK webapps/plugins can expose root-level paths like /@signalk/... and
  # /signalk-foo/...; route those to SignalK so they do not fall through to
  # Homepage.
  handle /@signalk* {
    reverse_proxy 127.0.0.1:3000
  }
  handle /signalk-* {
    reverse_proxy 127.0.0.1:3000
  }

  # AvNav — strip prefix, serves from root
  handle_path /avnav* {
    reverse_proxy 127.0.0.1:8088 {
      # AvNav can redirect to root-relative paths; keep them under /avnav.
      header_down Location "^(?:https?://[^/]+)?(/.*)$" "/avnav$1"
    }
  }

  # AvNav emits root-relative URLs for its static assets and WebSocket.
  # Route these specific paths to AvNav so they don't fall through to Homepage.
  handle /modules/* {
    reverse_proxy 127.0.0.1:8088
  }
  handle /viewer/* {
    reverse_proxy 127.0.0.1:8088
  }
  handle /plugins/* {
    reverse_proxy 127.0.0.1:8088
  }
  handle /user/* {
    reverse_proxy 127.0.0.1:8088
  }
  handle /remotechannels/* {
    reverse_proxy 127.0.0.1:8088
  }

  # InfluxDB — strip prefix, SPA serves from root
  handle_path /influxdb* {
    reverse_proxy 127.0.0.1:8086
  }

  # Nextcloud — NOTE: requires overwritewebroot=/nextcloud in config.php
  #             for full functionality (redirects, asset paths)
  handle_path /nextcloud* {
    reverse_proxy 127.0.0.1:8080
  }

  # Cockpit — NOTE: requires UrlRoot=/cockpit in /etc/cockpit/cockpit.conf
  # Cockpit expects the trailing slash at the UrlRoot path.
  @cockpit_noslash path /cockpit
  redir @cockpit_noslash /cockpit/ 302
  handle /cockpit* {
    reverse_proxy 127.0.0.1:9090
  }

    # Default: proxy to Homepage dashboard
    handle {
        reverse_proxy 127.0.0.1:3002
    }
}

# Import dynamic snippets (captive portal proxy, etc.)
import /etc/caddy/conf.d/*.caddy
