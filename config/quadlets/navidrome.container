[Unit]
Description=Navidrome music streaming server
PartOf=seabird-services.target
Documentation=https://www.navidrome.org/docs
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/seabird/navidrome /srv/seabird/music

[Container]
Image=docker.io/deluan/navidrome:latest
ContainerName=navidrome
AutoUpdate=registry
Pull=missing

PublishPort=4533:4533

# Navidrome data directory (db, cache, transcoding state)
Volume=/srv/seabird/navidrome:/data:Z
# Music collection — read-only
Volume=/srv/seabird/music:/music:ro,z

Environment=ND_MUSICFOLDER=/music
Environment=ND_DATAFOLDER=/data
Environment=ND_LOGLEVEL=info
Environment=ND_SESSIONTIMEOUT=24h
# Run as root so it can write to Z-labeled volume
User=root

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=seabird-services.target default.target
