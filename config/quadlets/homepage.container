[Unit]
Description=Homepage dashboard
PartOf=seabird-services.target
Documentation=https://gethomepage.dev
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/gethomepage/homepage:latest
ContainerName=homepage
AutoUpdate=registry
Pull=missing

PublishPort=3002:3000

# Homepage checks exact Host header values (no CIDR matching).
# seabird.local (no port) is used when Caddy proxies :80 → homepage
Environment=HOMEPAGE_ALLOWED_HOSTS=seabird.local,seabird.local:3002,100.64.0.1,100.64.0.1:3002,192.168.42.1,192.168.42.1:3002,192.168.29.1,192.168.29.1:3002
# Config files — create these in /srv/seabird/homepage/ to customise:
#   services.yaml   — service tiles
#   bookmarks.yaml  — bookmark links
#   widgets.yaml    — top-bar widgets (weather, search, etc.)
#   settings.yaml   — general settings
#   docker.yaml     — (not used here — we use direct service URLs)
Volume=/srv/seabird/homepage:/app/config:Z

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=seabird-services.target default.target
