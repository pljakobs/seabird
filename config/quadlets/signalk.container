[Unit]
Description=Signal-K marine data server
PartOf=seabird-services.target
Documentation=https://signalk.org
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/seabird/signalk

[Container]
Image=docker.io/signalk/signalk-server:latest
ContainerName=signalk
AutoUpdate=registry
Pull=missing

# Publish Signal-K HTTP/WS on port 3000
PublishPort=3000:3000
# NMEA 0183 over TCP (SignalK data connections)
PublishPort=10110:10110

# Persistent data — plugin config, vessel data, log files
# SignalK stores runtime state under /home/node/.signalk
Volume=/srv/seabird/signalk:/home/node/.signalk

# Disable SELinux labeling — btrfs subvolume relabeling (:z/:Z) doesn't work
# reliably; host dir is already labeled container_file_t which is sufficient
SecurityLabelDisable=true

# Signal-K needs to know the vessel MMSI/name — configure via
# /srv/seabird/signalk/settings.json on first start or via the web UI
# at http://seabird.local:3000

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=seabird-services.target default.target
