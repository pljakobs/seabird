[Unit]
Description=AvNav Navigation Server Container
PartOf=seabird-services.target
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/seabird/avnav

[Container]
# wellenvogel/avnav is not publicly pullable; xfreex images provide amd64+arm64 manifests
Image=docker.io/xfreex/avnav-daily:latest
ContainerName=avnav
AutoUpdate=registry
Pull=missing

# Persistent storage for charts, logs, tracks, and layouts
# xfreex/avnav-stable writes runtime state under /var/lib/avnav
Volume=/srv/seabird/avnav:/var/lib/avnav:Z

# Web UI port allocation (AvNav HTTP server)
PublishPort=8088:8080
# ochartsng plugin backend
PublishPort=8083:8083

# Give AvNav/ochartsng enough time to shut down cleanly on updates/restarts
StopTimeout=60

# Device access for hardware peripherals (GPS, AIS via USB-to-Serial)
# Adjust /dev/ttyUSB0 if your serial interface uses a different designation
# Device=/dev/ttyUSB0:/dev/ttyUSB0
# ocharts helper probes /dev/disk/by-uuid for media/license discovery
Volume=/dev/disk:/dev/disk:ro

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=seabird-services.target default.target
